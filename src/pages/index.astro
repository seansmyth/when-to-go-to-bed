---
const vapidPublicKey = import.meta.env.PUBLIC_VAPID_KEY ?? '';
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="theme-color" content="#14162b" />
		<meta name="apple-mobile-web-app-title" content="Bedtime" />
		<link rel="manifest" href="/manifest.webmanifest" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<link rel="apple-touch-icon" href="/icons/apple-touch-icon.png" />
		<meta name="generator" content={Astro.generator} />
		<title>When to go to bed</title>
		<style>
			:root { color-scheme: light dark; font-family: system-ui, sans-serif; line-height: 1.5; }
			body { margin: 0 auto; max-width: 32rem; padding: 1rem; }
			input, button { font: inherit; }
			[hidden] { display: none !important; }
		</style>
		<style is:global>
			:root {
				--awake: #9ca3af;
				--wind-down: #f59e0b;
				--sleep: #6366f1;
				--alarm: #10b981;
			}

			.timeline-status { font-weight: 600; }

			/* Bar segments are sized by duration; labels sit above/below at their start point. */
			.timeline { margin: 1rem 0; }

			.timeline-row { position: relative; height: 3.6rem; }

			.timeline-bar {
				display: flex;
				height: 0.6rem;
				border-radius: 999px;
				overflow: hidden;
				background: var(--awake);
			}

			.timeline-segment { height: 100%; background: var(--colour); }

			.timeline-stop {
				position: absolute;
				max-width: 50%;
				padding-left: 0.35rem;
				border-left: 2px solid var(--colour);
				font-size: 0.8rem;
				line-height: 1.2;
				white-space: nowrap;
			}

			.timeline-row--top .timeline-stop { bottom: 0.25rem; padding-bottom: 0; }
			.timeline-row--bottom .timeline-stop { top: 0.25rem; }

			.timeline-stop--end {
				right: 0;
				padding-left: 0;
				padding-right: 0.35rem;
				border-left: 0;
				border-right: 2px solid var(--colour);
				text-align: right;
			}

			.timeline-label { display: block; opacity: 0.75; }
			.timeline-time { display: block; font-size: 1rem; font-weight: 600; }
			.timeline-length { display: block; opacity: 0.75; }

			.is-now { --colour: var(--awake); }
			.is-wind-down { --colour: var(--wind-down); }
			.is-sleep { --colour: var(--sleep); }
			.is-alarm { --colour: var(--alarm); }

			.options summary { cursor: pointer; font-weight: 600; padding: 0.5rem 0; }

			.card {
				margin: 1.5rem 0;
				padding: 0 1rem;
				border: 1px solid color-mix(in srgb, currentColor 20%, transparent);
				border-radius: 0.75rem;
			}

			.options .card { margin: 1rem 0 0; }
			.card h2 { font-size: 1.2rem; }
		</style>
	</head>
	<body>
		<main>
			<h1>When to go to bed</h1>

			<section>
				<h2>Tomorrow morning</h2>
				<form id="plan-form">
					<p>
						<label for="wake-time">What time are you getting up?</label><br />
						<input type="time" id="wake-time" required />
					</p>
				</form>
				<div id="plan-result" aria-live="polite" hidden></div>

				<details class="options" id="options">
					<summary>Options</summary>
					<p>
						<label for="sleep-hours">Hours of sleep</label><br />
						<input type="number" id="sleep-hours" form="plan-form" min="1" max="14" step="0.25" value="8" required />
					</p>
					<p>
						<label for="wind-down">Start winding down (minutes before bed)</label><br />
						<input type="number" id="wind-down" form="plan-form" min="0" max="180" step="5" value="30" required />
					</p>
					<div id="options-reminder"></div>
				</details>
			</section>

			<section class="card" id="reminder-card" hidden>
				<h2>Daily reminder</h2>
				<p>Get a nudge at 5:13pm every day (your local time) asking when you're up tomorrow.</p>
				<p id="notify-status">Checking…</p>
				<p>
					<button type="button" id="notify-allow" hidden>Allow notifications</button>
					<button type="button" id="notify-off" hidden>Turn off</button>
				</p>
			</section>
		</main>

		<script is:inline define:vars={{ vapidPublicKey }}>
			var STORAGE_KEY = 'wtgtb:v1';
			var API = '/api/subscription';
			var HOUR = 3600000;
			var MINUTE = 60000;
			var REMINDER_TIME = '17:13'; // TEST: change back to '20:00'

			var planForm = document.getElementById('plan-form');
			var wakeInput = document.getElementById('wake-time');
			var hoursInput = document.getElementById('sleep-hours');
			var windDownInput = document.getElementById('wind-down');
			var planResult = document.getElementById('plan-result');

			var notifyStatus = document.getElementById('notify-status');
			var notifyAllow = document.getElementById('notify-allow');
			var notifyOff = document.getElementById('notify-off');
			var reminderCard = document.getElementById('reminder-card');
			var optionsReminder = document.getElementById('options-reminder');
			var main = document.querySelector('main');

			// Once reminders are on, tuck the card away under Options; otherwise show it on the page.
			function placeReminderCard(on) {
				var target = on ? optionsReminder : main;
				if (reminderCard.parentNode !== target) target.appendChild(reminderCard);
				reminderCard.hidden = false;
			}


			/* ---------- Storage ---------- */

			function loadState() {
				try {
					return JSON.parse(localStorage.getItem(STORAGE_KEY)) || {};
				} catch (e) {
					return {};
				}
			}

			function saveState(patch) {
				var state = Object.assign(loadState(), patch);
				try {
					localStorage.setItem(STORAGE_KEY, JSON.stringify(state));
				} catch (e) {}
				return state;
			}

			/* ---------- Time helpers ---------- */

			function parseTime(value) {
				var parts = value.split(':');
				return { h: Number(parts[0]), m: Number(parts[1]) };
			}

			function formatTime(date) {
				return date.toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' });
			}

			function formatDay(date, now) {
				var today = new Date(now);
				today.setHours(0, 0, 0, 0);
				var day = new Date(date);
				day.setHours(0, 0, 0, 0);
				var diff = Math.round((day - today) / (24 * HOUR));
				if (diff === 0) return 'today';
				if (diff === 1) return 'tomorrow';
				if (diff === -1) return 'yesterday';
				return date.toLocaleDateString([], { weekday: 'long' });
			}

			function formatDuration(ms) {
				var mins = Math.max(0, Math.round(ms / MINUTE));
				var h = Math.floor(mins / 60);
				var m = mins % 60;
				if (!h) return m + 'm';
				return h + 'h' + (m ? ' ' + m + 'm' : '');
			}

			// Next time the clock shows this time (today if still ahead, otherwise tomorrow).
			function nextOccurrence(value, now) {
				var t = parseTime(value);
				var date = new Date(now);
				date.setHours(t.h, t.m, 0, 0);
				if (date <= now) date.setDate(date.getDate() + 1);
				return date;
			}

			function calculatePlan(wakeValue, hours, windDownMins, now) {
				var wake = nextOccurrence(wakeValue, now);
				var bed = new Date(wake.getTime() - hours * HOUR);
				var windDown = new Date(bed.getTime() - windDownMins * MINUTE);
				return { wake: wake, bed: bed, windDown: windDown, hours: hours };
			}

			/* ---------- Rendering ---------- */

			function el(tag, className, text) {
				var node = document.createElement(tag);
				if (className) node.className = className;
				if (text !== undefined) node.textContent = text;
				return node;
			}

			function stop(phase, label, time, length, percent) {
				var item = el('div', 'timeline-stop is-' + phase + (percent === null ? ' timeline-stop--end' : ''));
				// Keep labels from running off the right-hand edge.
				if (percent !== null) item.style.left = 'min(' + percent.toFixed(2) + '%, calc(100% - 6.5rem))';
				item.appendChild(el('span', 'timeline-label', label));
				item.appendChild(el('span', 'timeline-time', time));
				if (length) item.appendChild(el('span', 'timeline-length', length));
				return item;
			}

			function segment(phase, percent) {
				var node = el('span', 'timeline-segment is-' + phase);
				node.style.width = percent.toFixed(2) + '%';
				return node;
			}

			// Now → wind down → asleep → alarm, left to right, widths in proportion to time.
			function renderPlan(plan, now) {
				var phase = now >= plan.bed ? 'sleep' : now >= plan.windDown ? 'wind-down' : 'now';
				var status;

				if (phase === 'sleep') {
					status = "You're past bedtime. Sleep now and you'll get " + formatDuration(plan.wake - now) + '.';
				} else if (phase === 'wind-down') {
					status = 'Wind down now. Asleep in ' + formatDuration(plan.bed - now) + '.';
				} else {
					status = 'Wind down in ' + formatDuration(plan.windDown - now) + '.';
				}

				var start = now.getTime();
				var total = plan.wake - start;
				var windStart = Math.max(start, plan.windDown.getTime());
				var sleepStart = Math.max(start, plan.bed.getTime());

				function pct(ms) {
					return total > 0 ? (ms / total) * 100 : 0;
				}

				var awakePct = pct(windStart - start);
				var windPct = pct(sleepStart - windStart);
				var sleepPct = pct(plan.wake - sleepStart);

				var top = el('div', 'timeline-row timeline-row--top');
				var bar = el('div', 'timeline-bar');
				var bottom = el('div', 'timeline-row timeline-row--bottom');

				if (awakePct > 0) bar.appendChild(segment('now', awakePct));
				if (windPct > 0) bar.appendChild(segment('wind-down', windPct));
				bar.appendChild(segment('sleep', sleepPct));

				// Top row: wind down + alarm. Bottom row: now + asleep. Alternating stops them overlapping.
				if (phase !== 'sleep') {
					top.appendChild(stop('wind-down', 'Wind down', formatTime(plan.windDown), formatDuration(plan.bed - plan.windDown), awakePct));
				}
				top.appendChild(stop('alarm', 'Alarm', formatTime(plan.wake), formatDay(plan.wake, now), null));

				// Only show "now" when there's room before the "asleep" label.
				if (phase === 'now' && awakePct + windPct >= 30) {
					bottom.appendChild(stop('now', 'Now', formatTime(now), formatDuration(plan.windDown - now), 0));
				}
				bottom.appendChild(stop('sleep', phase === 'sleep' ? 'Asleep now' : 'Be asleep', formatTime(phase === 'sleep' ? now : plan.bed), formatDuration(plan.wake - sleepStart), awakePct + windPct));

				var timeline = el('div', 'timeline');
				timeline.appendChild(top);
				timeline.appendChild(bar);
				timeline.appendChild(bottom);

				planResult.replaceChildren(el('p', 'timeline-status', status), timeline);
				planResult.hidden = false;
			}

			/* ---------- Push / API ---------- */

			function pushSupported() {
				return 'serviceWorker' in navigator && 'PushManager' in window && 'Notification' in window;
			}

			function urlBase64ToUint8Array(base64) {
				var padding = '='.repeat((4 - (base64.length % 4)) % 4);
				var raw = atob((base64 + padding).replace(/-/g, '+').replace(/_/g, '/'));
				var output = new Uint8Array(raw.length);
				for (var i = 0; i < raw.length; i++) output[i] = raw.charCodeAt(i);
				return output;
			}

			async function api(method, body) {
				var response = await fetch(API, {
					method: method,
					headers: { 'Content-Type': 'application/json' },
					body: JSON.stringify(body)
				});
				if (response.status === 404) {
					throw new Error(/^(localhost|127\.0\.0\.1)$/.test(location.hostname)
						? "The reminder API isn't running. Use `npx netlify dev` instead of `npm run dev`."
						: "The reminder API wasn't found (404). Check the Netlify functions deployed.");
				}
				if (!response.ok) throw new Error('Server said ' + response.status);
				return response.json();
			}

			async function getSubscription() {
				if (!pushSupported()) return null;
				var registration = await navigator.serviceWorker.getRegistration();
				return registration ? registration.pushManager.getSubscription() : null;
			}

			async function enableReminders() {
				if (!vapidPublicKey) throw new Error('PUBLIC_VAPID_KEY is not set, see the README.');

				var permission = await Notification.requestPermission();
				if (permission !== 'granted') throw new Error('Notifications were not allowed.');

				var registration = await navigator.serviceWorker.ready;
				var subscription = await registration.pushManager.getSubscription();
				if (!subscription) {
					subscription = await registration.pushManager.subscribe({
						userVisibleOnly: true,
						applicationServerKey: urlBase64ToUint8Array(vapidPublicKey)
					});
				}

				await api('PUT', {
					subscription: subscription.toJSON(),
					reminderTime: REMINDER_TIME,
					timeZone: currentTimeZone()
				});
			}

			async function disableReminders() {
				var subscription = await getSubscription();
				if (!subscription) return;
				var endpoint = subscription.endpoint;
				await subscription.unsubscribe();
				await api('DELETE', { endpoint: endpoint });
			}

			// Tell the server tonight's wind-down time so it can nudge you.
			async function sendPlan(plan) {
				var subscription = await getSubscription();
				if (!subscription || !navigator.onLine) return;
				var now = new Date();
				await api('PUT', {
					endpoint: subscription.endpoint,
					windDownAt: plan.windDown > now ? plan.windDown.toISOString() : null,
					windDownBody: 'Bed at ' + formatTime(plan.bed) + ' to be up at ' + formatTime(plan.wake) + '.'
				});
			}

			function currentTimeZone() {
				return Intl.DateTimeFormat().resolvedOptions().timeZone;
			}

			async function refreshNotifyStatus() {
				notifyAllow.hidden = true;
				notifyOff.hidden = true;

				if (!pushSupported()) {
					notifyStatus.textContent = "This browser doesn't support notifications.";
					placeReminderCard(false);
					return;
				}

				if (Notification.permission === 'denied') {
					notifyStatus.textContent = 'Notifications are blocked. In Chrome, tap the icon left of the address bar → Permissions → Notifications → Allow, then reload.';
					placeReminderCard(false);
					return;
				}

				var subscription = await getSubscription();
				var on = Boolean(subscription && Notification.permission === 'granted' && loadState().remindersOn);

				notifyStatus.textContent = on ? 'Reminders are on.' : 'Reminders are off.';
				notifyAllow.hidden = on;
				notifyOff.hidden = !on;
				placeReminderCard(on);
			}

			// Travelled since turning reminders on? Tell the server your new time zone
			// so the reminder still lands at 8pm wherever you are.
			async function syncTimeZone() {
				var state = loadState();
				var timeZone = currentTimeZone();
				if (!state.remindersOn || !navigator.onLine) return;
				if (state.timeZone === timeZone && state.reminderTime === REMINDER_TIME) return;
				var subscription = await getSubscription();
				if (!subscription) return;
				// Also pushes a changed REMINDER_TIME to anyone already subscribed.
				await api('PUT', { endpoint: subscription.endpoint, timeZone: timeZone, reminderTime: REMINDER_TIME });
				saveState({ timeZone: timeZone, reminderTime: REMINDER_TIME });
			}

			/* ---------- Events ---------- */

			var sendTimer = null;

			function readInputs() {
				var hours = Number(hoursInput.value);
				var windDownMins = Number(windDownInput.value);
				if (!wakeInput.value || !(hours > 0) || hoursInput.value === '' || windDownInput.value === '' || !(windDownMins >= 0)) return null;
				return { wakeTime: wakeInput.value, hours: hours, windDownMins: windDownMins };
			}

			function update(options) {
				var inputs = readInputs();
				if (!inputs) return;
				var now = new Date();
				var plan = calculatePlan(inputs.wakeTime, inputs.hours, inputs.windDownMins, now);
				renderPlan(plan, now);

				if (options && options.save) {
					saveState(Object.assign(inputs, { wakeAt: plan.wake.toISOString() }));
					// Wait until you've stopped typing before telling the server.
					clearTimeout(sendTimer);
					sendTimer = setTimeout(function () {
						sendPlan(plan).catch(warn('Could not send plan'));
					}, 1500);
				}
			}

			function onInput() {
				update({ save: true });
			}

			planForm.addEventListener('submit', function (event) {
				event.preventDefault();
			});
			wakeInput.addEventListener('input', onInput);
			hoursInput.addEventListener('input', onInput);
			windDownInput.addEventListener('input', onInput);

			notifyAllow.addEventListener('click', function () {
				notifyStatus.textContent = 'Turning on…';
				enableReminders()
					.then(function () {
						saveState({ remindersOn: true, timeZone: currentTimeZone(), reminderTime: REMINDER_TIME });
					})
					.catch(function (error) {
						alert(error.message);
					})
					.finally(refreshNotifyStatus);
			});

			notifyOff.addEventListener('click', function () {
				disableReminders()
					.catch(function (error) {
						console.warn('Could not unsubscribe', error);
					})
					.finally(function () {
						saveState({ remindersOn: false });
						refreshNotifyStatus();
					});
			});

			function warn(label) {
				return function (error) {
					console.warn(label, error);
				};
			}

			function focusWakeInputIfFromReminder(url) {
				if (new URL(url, location.href).searchParams.get('from') === 'reminder') wakeInput.focus();
			}

			/* ---------- Start up ---------- */

			(function init() {
				var state = loadState();
				var now = new Date();
				if (state.wakeTime) wakeInput.value = state.wakeTime;
				if (state.hours) hoursInput.value = state.hours;
				if (state.windDownMins != null) windDownInput.value = state.windDownMins;

				// Still before the alarm you set last time? Show that plan again.
				if (state.wakeAt && new Date(state.wakeAt) > now) update();

				// Keep the countdown current while the app is open.
				setInterval(function () {
					if (!planResult.hidden) update();
				}, MINUTE);
				document.addEventListener('visibilitychange', function () {
					if (document.visibilityState === 'visible' && !planResult.hidden) update();
				});

				if ('serviceWorker' in navigator) {
					navigator.serviceWorker.register('/sw.js')
						.then(refreshNotifyStatus)
						.then(syncTimeZone)
						.catch(warn('Service worker failed'));
					navigator.serviceWorker.addEventListener('message', function (event) {
						if (event.data && event.data.type === 'notification-click') focusWakeInputIfFromReminder(event.data.url);
					});
				}

				focusWakeInputIfFromReminder(location.href);
				refreshNotifyStatus();
				window.addEventListener('online', function () {
					syncTimeZone().catch(warn('Could not update time zone'));
				});
			})();
		</script>
	</body>
</html>
